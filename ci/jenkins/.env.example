# Copy this file to .env and fill it in. .env is git-ignored.

# Jenkins login
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me

# Docker Hub account that owns the linkvault images, and an access token
# (Docker Hub > Account settings > Personal access tokens, Read & Write)
DOCKERHUB_USER=mahmoudali2111
DOCKERHUB_TOKEN=

# Docker Hub already has tags up to 46 from Azure Pipelines.
# Jenkins' first build will be this number.
NEXT_BUILD_NUMBER=47
